---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieCard from '../MovieCard.astro';
import Icon from '../Icon.astro';
import AbridgedNotice from '../AbridgedNotice.astro';
import SeasonEndNotice from '../SeasonEndNotice.astro';
import { getHaarlemMovies, getUpcomingMovies, getNextMovie } from '../../lib/sheets';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { isSeasonOver } from '../../lib/season';
import { mapsSearchUrl } from '../../lib/programs';
import { CALENDAR_ENABLED } from '../../lib/features';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const movies = getHaarlemMovies();
const upcomingMovies = getUpcomingMovies(movies);
const nextMovie = getNextMovie(movies);

// Same end-of-season switch as the homepage, so a site that has not been
// rebuilt does not keep listing September as "upcoming". See src/lib/season.ts.
const over = isSeasonOver();
const showMovies = !over && upcomingMovies.length > 0;

// The venues come from the screenings themselves — this programme runs at a
// different place each night, so a single hardcoded park address would be
// wrong for at least one of them.
const localeMap: Record<string, string> = { nl: 'nl-NL', en: 'en-US', ara: 'ar-SA' };
const venues = upcomingMovies
  .filter((m) => m.location)
  .map((m) => {
    const d = new Date(m.date);
    return {
      date: Number.isNaN(d.getTime())
        ? ''
        : d.toLocaleDateString(localeMap[lang] || 'en-US', { day: 'numeric', month: 'short' }),
      venue: m.location,
      href: mapsSearchUrl(m.location, m.program),
    };
  });
---

<BaseLayout title={`${t('schedule.title')} — ${t('schedule.locationHaarlem')}`} description="Bekijk het volledige programma van Nelsons Film in Haarlem">
  <section class="schedule-page section">
    <div class="container">
      <div class="back-link">
        <a href={getLocalizedPath('/programma', lang)}>← {t('schedule.locations')}</a>
      </div>

      <header class="page-header">
        <h1>{t('schedule.title')} — {t('schedule.locationHaarlem')}</h1>
        {CALENDAR_ENABLED && showMovies && (
          <a href="/programma/haarlem.ics" class="calendar-btn" data-season="active"
             data-goatcounter-click="calendar-haarlem"
             data-goatcounter-title="Calendar download">
            <Icon name="calendar" size={18} /> {t('schedule.addToCalendar')}
          </a>
        )}
        <p class="page-info">{t('schedule.selectionInfo')}</p>
        <p class="page-free">{t('schedule.freeInfo')}</p>
      </header>

      {showMovies && (
        <div class="movies-grid grid grid-2" data-season="active">
          {upcomingMovies.map((movie) => (
            <MovieCard
              title={movie.title}
              descriptionNl={movie.descriptionNl}
              descriptionEn={movie.descriptionEn}
              descriptionAra={movie.descriptionAra}
              rating={movie.rating}
              contentWarnings={movie.contentWarnings}
              date={movie.date}
              time={movie.time}
              language={movie.language}
              subtitles={movie.subtitles}
              headphones={movie.headphones}
              previewUrl={movie.previewUrl}
              program={movie.program}
              location={movie.location}
              preProgramStartMin={movie.preProgramStartMin}
              preProgramNl={movie.preProgramNl}
              preProgramEn={movie.preProgramEn}
              preProgramAra={movie.preProgramAra}
              isNext={nextMovie?.date === movie.date}
            />
          ))}
        </div>
      )}

      {showMovies && (
        <div data-season="active">
          <AbridgedNotice />
        </div>
      )}

      <div data-season={over ? undefined : 'over'}>
        <SeasonEndNotice />
      </div>

      <div class="schedule-info">
        <div class="info-card">
          <h3><Icon name="headphones" size={22} /> {t('schedule.multilingualTitle')}</h3>
          <p>{t('schedule.multilingualText')}</p>
        </div>

        <div class="info-card">
          <h3><Icon name="users" size={22} /> {t('schedule.whatToBringTitle')}</h3>
          <p>{t('schedule.whatToBringText')}</p>
        </div>

        <div class="info-card location-card">
          <h3><Icon name="map-pin" size={22} /> {t('location.title')}</h3>
          {showMovies && (
            <ul class="venue-list" data-season="active">
              {venues.map((v) => (
                <li class="venue-item">
                  {v.date && <span class="venue-date">{v.date}</span>}
                  <a href={v.href} target="_blank" rel="noopener" class="map-link">
                    {v.venue}
                  </a>
                </li>
              ))}
            </ul>
          )}
          <p data-season={over ? undefined : 'over'}>{t('schedule.locationHaarlem')}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .schedule-page {
    min-height: 80vh;
  }

  .back-link {
    margin-bottom: var(--space-md);
  }

  .back-link a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .back-link a:hover {
    color: var(--color-accent);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .page-subtitle {
    color: var(--color-text);
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: var(--space-sm);
  }

  .page-info {
    color: var(--color-text-muted);
    font-size: 1rem;
    margin-top: var(--space-md);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .page-free {
    color: var(--color-accent);
    font-size: 0.95rem;
    font-weight: 500;
    margin-top: var(--space-sm);
  }

  .calendar-btn {
    display: inline-block;
    margin-top: var(--space-md);
    padding: var(--space-md) var(--space-xl);
    background: rgba(215, 110, 77, 0.1);
    border: 1px solid rgba(215, 110, 77, 0.3);
    border-radius: var(--radius-md);
    color: var(--color-accent);
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .calendar-btn:hover {
    background: rgba(215, 110, 77, 0.2);
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .movies-grid {
    margin-bottom: var(--space-xl);
  }

  .no-movies {
    padding: var(--space-xl);
    background: var(--color-card);
    border-radius: var(--radius-lg);
  }

  .schedule-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .info-card {
    background: var(--color-card);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .info-card h3 {
    margin-bottom: var(--space-sm);
  }

  .info-card p {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .venue-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .venue-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    line-height: 1.5;
  }

  .venue-date {
    flex-shrink: 0;
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .location-card .map-link {
    color: var(--color-accent);
    font-weight: 500;
  }

  .location-card .map-link:hover {
    color: var(--color-accent-light);
  }
</style>
